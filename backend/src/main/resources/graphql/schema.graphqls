scalar DateTime

type Query {
    """
    WORKED EXAMPLE. Returns every property. Use this as your reference:
    schema -> resolver (PropertyGraphqlController) -> repository -> React component.
    """
    properties: [Property!]!

    """
    Fetches today's arrivals for a specific property.
    """
    todayArrivals(propertyId: ID!): [Reservation!]!

    # =====================================================================
    # YOUR TASK: add a query returning today's arrivals for one property.
    # The shape is up to you. Design it as you would for a real backoffice.
    # =====================================================================
}

type Property {
    id: ID!
    code: String!
    name: String!
    timezone: String!
}

type Unit {
    id: ID!
    label: String!
    floor: Int
}

type Reservation {
    id: ID!
    guestName: String!
    arrival: String!
    assignedUnit: Unit
}
